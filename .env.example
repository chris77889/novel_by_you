# --- AI Service Configuration ---
# Your AI service API Key (e.g., OpenAI, Groq, Gemini, etc.)
VITE_AI_API_KEY="YOUR_AI_API_KEY_HERE"

# Model configuration for the "Creative" style
VITE_AI_CREATIVE_MODEL_NAME="YOUR_CREATIVE_MODEL_NAME_HERE" # e.g., gemini-1.5-flash-latest
VITE_AI_CREATIVE_MODEL_ENDPOINT="YOUR_CREATIVE_MODEL_ENDPOINT_HERE" # e.g., https://api.example.com/v1/chat/completions

# Model configuration for the "Precise" style
VITE_AI_PRECISE_MODEL_NAME="YOUR_PRECISE_MODEL_NAME_HERE"
VITE_AI_PRECISE_MODEL_ENDPOINT="YOUR_PRECISE_MODEL_ENDPOINT_HERE"

# Model configuration for the "Balanced" style
VITE_AI_BALANCED_MODEL_NAME="YOUR_BALANCED_MODEL_NAME_HERE"
VITE_AI_BALANCED_MODEL_ENDPOINT="YOUR_BALANCED_MODEL_ENDPOINT_HERE"

# --- Optional Configuration ---
# Threshold for triggering structure thinking and preference analysis (default is 5)
# VITE_STRUCTURE_THINKING_THRESHOLD=5
